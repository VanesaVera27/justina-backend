# Conexion a PostgreSQL. Copiar este archivo como .env y ajustar valores.
# Hay dos formas de configurar el pool (DATABASE_URL tiene prioridad si esta definida).

# --- Forma 1: variables separadas ---

# Local por socket Unix (autenticacion peer, sin password):
# DB_HOST=/var/run/postgresql
# DB_PORT=5432
# DB_USUARIO=matias
# DB_CONTRASENA=
# DB_NOMBRE=justina

# TCP en otra PC (usuario y password explicitos):
# DB_HOST=localhost
# DB_PORT=5432
# DB_USUARIO=usuario
# DB_CONTRASENA=contrasena
# DB_NOMBRE=justina

# --- Forma 2: DATABASE_URL completa (alternativa, tiene prioridad) ---
# La URL puede apuntar a TCP (localhost:5432) o al socket peer.
# DATABASE_URL=postgres://usuario:contrasena@localhost:5432/justina
# DATABASE_URL=postgres://matias@/justina?host=/var/run/postgresql
